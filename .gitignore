# Allowlist: ignora tudo, depois readiciona so o que faz parte do projeto.
*

# Deixa o git DESCER nas subpastas. Termina em "/", entao o mapear.py ignora
# esta linha de proposito (a condicao la e: nao terminar em "/").
!*/

# Raiz
!.gitignore
!CHANGELOG.md
!LICENSE
!README.md
!pyproject.toml
!conftest.py

# Pacote
!pyresumidor/*.py
!pyresumidor/core/*.py
!pyresumidor/cli/*.py

# GUI
!pyresumidor/gui/*.py
!pyresumidor/gui/modelos/*.py
!pyresumidor/gui/paginas/*.py
!pyresumidor/gui/workers/*.py

# Testes
!tests/*.py
